# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Theme
theme = Gruvbox Dark

# Aesthetics
background-opacity = 0.9
background-blur-radius = 20
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = true

# Features
copy-on-select = true
confirm-close-surface = false
mouse-hide-while-typing = true
# Disable click-to-move-cursor: in Ghostty 1.3.x, double-clicking non-interactive
# prompt text (e.g. the Starship branch name) yanks the cursor to column 0.
# See ghostty-org/ghostty discussions #12044 and #11386.
cursor-click-to-move = false

# Layout/Navigation
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface

keybind = super+h=previous_tab
keybind = super+l=next_tab

# AI/Workflow
shell-integration = zsh
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-screen = mouse
quick-terminal-autohide = false

keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
keybind = cmd+shift+p=toggle_command_palette
keybind = cmd+shift+r=toggle_readonly
keybind = cmd+shift+s=toggle_secure_input
keybind = cmd+shift+o=write_scrollback_file:open
keybind = cmd+shift+c=write_scrollback_file:copy

window-save-state = always
